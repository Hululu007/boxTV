<?xml version="1.0" encoding="utf-8"?>
<!--
    播放页布局（2026-11-07 播放器升级）
    结构：全屏 PlayerView（Media3 控制条）+ 居中状态提示 + 右侧菜单面板。
    菜单面板（遥控器「菜单」键呼出/关闭）：
    - 播放信息：视频名称 / 播放进度 / 分辨率·清晰度·播放状态；
    - 清晰度：1080P（原画直连，默认）/ 720P / 480P（电脑端 ffmpeg 实时转码）；
    - 选集：当前文件夹内的视频列表，点击直接切换播放。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="视频播放画面"
        app:controller_layout_id="@layout/exo_player_control_view_custom" />

    <!-- 加载/错误提示 -->
    <TextView
        android:id="@+id/playback_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- 快进/快退反馈气泡（长按步进时的目标位置预览，自动隐藏） -->
    <TextView
        android:id="@+id/seek_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="56dp"
        android:background="@drawable/bg_seek_feedback"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- ~~~~~~~~~~~~ 播放器菜单面板（右侧抽屉） ~~~~~~~~~~~~ -->
    <LinearLayout
        android:id="@+id/menu_panel"
        android:layout_width="430dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#F20D0D0D"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <!-- 视频名称 -->
        <TextView
            android:id="@+id/menu_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- 播放进度（如：播放进度：12:34 / 1:59:59（10%）） -->
        <TextView
            android:id="@+id/menu_info_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#DDDDDD"
            android:textSize="15sp" />

        <!-- 分辨率 / 清晰度 / 播放状态 -->
        <TextView
            android:id="@+id/menu_info_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#999999"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#26FFFFFF" />

        <!-- 清晰度选择区 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="清晰度"
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_quality_1080"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_menu_chip"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:paddingVertical="9dp"
                android:text="1080P"
                android:textColor="@color/chip_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btn_quality_720"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_menu_chip"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:paddingVertical="9dp"
                android:text="720P"
                android:textColor="@color/chip_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btn_quality_480"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_menu_chip"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="20dp"
                android:paddingVertical="9dp"
                android:text="480P"
                android:textColor="@color/chip_text"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 档位说明 -->
        <TextView
            android:id="@+id/menu_quality_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="1080P 为原画直连；更低档位由电脑端实时转码，更省流量"
            android:textColor="#777777"
            android:textSize="12sp" />

        <!-- 音量增益区（2026-11-08 交互改版）：[−] 增益值 [+] 三件套横排，
             遥控器 DPAD 左右在 −/+ 间移动焦点，OK 键每次步进 10%（0-200%），
             替代原「OK 键单项循环档位」不便微调的交互 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#26FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="音量增益"
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 减档按钮（圆形） -->
            <TextView
                android:id="@+id/btn_gain_minus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_gain_round"
                android:focusable="true"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/chip_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- 当前增益值显示胶囊（仅展示，不可聚焦） -->
            <TextView
                android:id="@+id/btn_gain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_gain_value"
                android:gravity="center"
                android:minWidth="110dp"
                android:paddingHorizontal="20dp"
                android:paddingVertical="9dp"
                android:text="100%（标准）"
                android:textColor="#111111"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- 加档按钮（圆形） -->
            <TextView
                android:id="@+id/btn_gain_plus"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_gain_round"
                android:focusable="true"
                android:gravity="center"
                android:text="＋"
                android:textColor="@color/chip_text"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="系统音量拉满仍偏低的机型可调高增益，按 − / ＋ 每次步进 10%（0-200%）"
            android:textColor="#777777"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#26FFFFFF" />

        <!-- 选集区：当前文件夹内的视频，点击直接切换播放 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="选集（当前文件夹）"
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/episode_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:focusable="false"
            android:scrollbars="none" />

        <!-- 选集空态 -->
        <TextView
            android:id="@+id/episode_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="当前文件夹没有其他视频"
            android:textColor="#777777"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
