<?xml version="1.0" encoding="utf-8"?>
<!-- 清晰度胶囊按钮文字颜色：聚焦/选中（白底）→ 黑字；常态 → 白字 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#1B1B1B" />
    <item android:state_selected="true" android:color="#1B1B1B" />
    <item android:color="#FFFFFF" />
</selector>
